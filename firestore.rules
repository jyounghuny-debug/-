rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'jyounghuny@gmail.com') ||
        request.auth.uid == 'jyounghuny@gmail.com'
      );
    }

    function isManager() {
      return isOwner() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/managers/$(request.auth.uid)) ||
          (request.auth.token.email != null && exists(/databases/$(database)/documents/managers/$(request.auth.token.email)))
        )
      );
    }

    // Authorized church managers directory
    match /managers/{managerId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Church public content (readable by all visitors, writable only by owner and authorized managers)
    match /church_data/{contentId} {
      allow read: if true;
      allow write: if isManager();
    }
  }
}
